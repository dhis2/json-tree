<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.3.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.3.0 https://maven.apache.org/xsd/settings-1.3.0.xsd">

    <servers>
        <server>
            <id>central</id>
            <username>${env.SONATYPE_PORTAL_USERNAME}</username>
            <password>${env.SONATYPE_PORTAL_PASSWORD}</password>
            <repositoryOrigins>
                <repositoryOrigin>https://central.sonatype.com</repositoryOrigin>
            </repositoryOrigins>
        </server>
    </servers>

    <profiles>
        <profile>
            <id>central</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <gpg.executable>gpg</gpg.executable>
                <gpg.passphrase>${env.GPG_PASSPHRASE}</gpg.passphrase>
            </properties>
        </profile>
    </profiles>
</settings>
